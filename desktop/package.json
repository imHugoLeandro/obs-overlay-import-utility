{
  "name": "obs-overlay-import-utility-desktop",
  "version": "0.1.0-foundation",
  "description": "Electron + React desktop shell for OBS Overlay Import Utility (foundation stage)",
  "main": "src/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:renderer\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron . --dev",
    "build": "npm run build:renderer && electron-builder --config",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\""
  },
  "config": {
    "electron:serve": "http://localhost:5173"
  },
  "dependencies": {
    "electron": "34.0.0"
  },
  "devDependencies": {
    "@electron/remote": "2.1.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.10.0",
    "@types/react": "18.3.14",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.18.0",
    "@typescript-eslint/parser": "8.18.0",
    "@vitejs/plugin-react": "5.1.0",
    "concurrently": "9.1.2",
    "electron-builder": "26.0.2",
    "eslint": "9.17.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react": "7.37.2",
    "jsdom": "29.1.1",
    "prettier": "3.4.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "typescript": "5.7.3",
    "vite": "6.0.7",
    "wait-on": "8.0.1",
    "vitest": "3.0.0"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "build": {
    "appId": "com.socialspace.obs-overlay-import-utility",
    "productName": "OBS Overlay Import Utility",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "!src/main/**/*.map",
      "!**/.*",
      "!**/README.md"
    ],
    "extraMetadata": {
      "main": "src/main/index.js"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": ["dmg", "zip"]
    },
    "win": {
      "target": ["nsis", "zip"],
      "artifactName": "OBS-Overlay-Import-Utility"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  }
}
